# GEMINI_API_KEY: Required for the Inky AI Engine (AI Writing Coach for
# PKSK Artikulasi Karangan, and future Math/Science/BM/BI Coach modules).
# Server-side only — set this in your Vercel project's Environment
# Variables (no VITE_ prefix, so it never reaches the browser bundle).
# Used exclusively by api/_lib/inkyEngine.ts.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase Credentials (Required for remote Postgres & Auth sync)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
