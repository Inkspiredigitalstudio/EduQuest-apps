# ANTHROPIC_API_KEY: Required for the AI Writing Coach (PKSK Artikulasi
# Karangan). Server-side only — set this in your Vercel project's
# Environment Variables (no VITE_ prefix, so it never reaches the browser
# bundle). Used exclusively by api/articulation-ai.ts.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# Supabase Credentials (Required for remote Postgres & Auth sync)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
